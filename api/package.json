{
  "name": "krokdaeng-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute krokdaeng-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute krokdaeng-db --remote --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute krokdaeng-db --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute krokdaeng-db --remote --file=./migrations/0002_seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.162.0"
  }
}
